{
  "version": 3,
  "preset": "dark",
  "composition": {
    "panels": [{
      "id": "dock",
      "edge": "bottom",
      "style": { "length": "content", "maxLengthDp": 900, "edgeGapDp": 12, "sideGapDp": 12, "radiusDp": 8, "opacity": 0.9 },
