{
  "version": 2,
  "preset": "dark",
  "taskbar": { "width": "content", "maxWidthDp": 900, "bottomGapDp": 12, "sideGapDp": 12, "radiusDp": 8, "opacity": 0.9 },
  "composition": {
    "taskbar": [ { "type": "start" }, { "type": "tasks" }, { "type": "quick_controls" }, { "type": "clock" } ],
    "start": { "sections": ["apps", "recent", "tools"] }
  },
  "motion": { "panels": "fade", "taskbar": "fade", "durationMs": 160, "feedbackMs": 60 }
}
